    "server": "tsx src/server/server.ts",
    "doctor": "tsx src/server/cli.ts doctor",
    "cleanup": "tsx src/server/cli.ts cleanup",
    "trace-status": "tsx src/server/cli.ts trace-status",
    "init-db": "tsx src/server/cli.ts init-db",
    "inspect": "tsx src/server/cli.ts inspect",
    "wa-contacts": "tsx src/server/cli.ts wa-contacts",
    "import": "tsx src/server/cli.ts import",
    "unknown-report": "tsx src/server/cli.ts unknown-report",
    "search:reindex": "tsx src/server/cli.ts search-reindex",
    "brain:provider": "tsx src/server/cli.ts brain-provider",
    "brain:status": "tsx src/server/cli.ts brain-status",
    "brain:run": "tsx src/server/cli.ts brain-run",
    "brain:pass": "tsx src/server/cli.ts brain-pass",
    "brain:reset": "tsx src/server/cli.ts brain-reset",
    "live:proof": "tsx src/server/cli.ts live-proof",
    "live:start": "tsx src/server/cli.ts live-start",
    "live:status": "tsx src/server/cli.ts live-status",
    "live:gaps": "tsx src/server/cli.ts live-gaps",
    "memory:status": "tsx src/server/cli.ts memory-status",
    "memory:rem": "tsx src/server/cli.ts memory-rem",
    "memory:query": "tsx src/server/cli.ts memory-query",
    "memory:validate": "tsx src/server/cli.ts memory-validate",
    "generate-fixtures": "tsx src/server/cli.ts generate-fixtures",
    "roadmap:sync": "node openspec/tools/sync-roadmap-status.mjs",
