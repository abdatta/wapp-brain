ARCHIVE_DB_ADAPTER=sqlite
ARCHIVE_DB_PATH=.wapp-brain/archive.sqlite
APP_HOST=127.0.0.1
APP_PORT=3600
WAPP_WORK_DIR=.wapp-brain
# Live sync resumes automatically at server start when linked-device credentials exist.
# Set to false to require a manual Resume from the UI/CLI.
LIVE_AUTO_RESUME=true
# How often the connected maintainer attempts bounded gap recovery (milliseconds).
LIVE_RECOVERY_INTERVAL_MS=30000
# How many chats to backfill per recovery tick (each request queries your phone).
LIVE_MAX_CONCURRENT_CHAT_BACKFILLS=3
# How long after connecting to wait before the downtime audit, so offline/history
# events can land first (milliseconds).
LIVE_AUDIT_SETTLE_MS=60000
WAPP_MEMORY_DIR=.wapp-brain/memory
WAPP_MEMORY_PROVIDER=local
WAPP_MEMORY_REMOTE_MODEL_ENABLED=false
# --- Brain (tiered assimilation) ---
# Model provider for brain generation: extractive (no model, default),
# claude-cli, or codex. Model-backed providers additionally require explicit
# opt-in via `npm run brain:provider -- enable-<name>`.
WAPP_BRAIN_PROVIDER=extractive
# paused (default): the brain computes due work and shows a UI alert, but only
# user-triggered runs spend model budget. auto: scheduled runs execute alone.
WAPP_BRAIN_SCHEDULER=paused
# Command for a NATIVE Claude Code CLI binary (whitespace-split into
# executable + args; paths with spaces unsupported). Leave unset to bridge
# through WSL2: wsl.exe -e bash -lc "claude -p ..." with the prompt on stdin.
#WAPP_BRAIN_CLAUDE_CMD=claude
# Local hour after which the nightly consolidation may run.
WAPP_BRAIN_CUTOFF_HOUR=3
# A chat crossing this many pending visible messages (and quiet for a while)
# gets an intra-day episode instead of waiting for the nightly pass.
WAPP_BRAIN_VOLUME_TRIGGER=50
# Chats with fewer pending visible messages than this fold into weekly
# mini-episodes instead of consuming a nightly model call.
WAPP_BRAIN_SIGNIFICANCE_MIN=5
# Hard daily/hourly model-call ceilings; exceeding them is a named
# budget_exceeded block, never silent degradation.
WAPP_BRAIN_MAX_CALLS_PER_DAY=200
WAPP_BRAIN_MAX_CALLS_PER_HOUR=30
# Evidence pack size bound per model call.
WAPP_BRAIN_MAX_EVIDENCE_MESSAGES=150
# Consecutive provider failures before the brain enters the visible degraded
# (extractive-only) state and raises an alert.
WAPP_BRAIN_PROVIDER_FAILURE_THRESHOLD=3
