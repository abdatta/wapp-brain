ARCHIVE_DB_ADAPTER=sqlite
ARCHIVE_DB_PATH=.wapp-brain/archive.sqlite
APP_HOST=127.0.0.1
APP_PORT=3600
WAPP_WORK_DIR=.wapp-brain
# Live sync resumes automatically at server start when linked-device credentials exist.
# Set to false to require a manual Resume from the UI/CLI.
LIVE_AUTO_RESUME=true
# How often the connected maintainer attempts bounded gap recovery (milliseconds).
LIVE_RECOVERY_INTERVAL_MS=30000
# How many chats to backfill per recovery tick (each request queries your phone).
LIVE_MAX_CONCURRENT_CHAT_BACKFILLS=3
# How long after connecting to wait before the downtime audit, so offline/history
# events can land first (milliseconds).
LIVE_AUDIT_SETTLE_MS=60000
WAPP_MEMORY_DIR=.wapp-brain/memory
WAPP_MEMORY_PROVIDER=local
WAPP_MEMORY_REMOTE_MODEL_ENABLED=false
